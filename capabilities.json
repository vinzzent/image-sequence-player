  "dataViewMappings": [
  {
    "categorical": {
      "categories": {
        "for": {
          "in": "category"
        },
        "dataReductionAlgorithm": {
          "top": {
            "count": 3500
          }
        }
      },
      "values": {
        "select": [
          {
            "bind": {
              "to": "imageUri"
            }
          },
          {
            "bind": {
              "to": "value"
            }
          }
        ],
        "dataReductionAlgorithm": {
          "top": {
            "count": 3500
          }
        }
      }
    }
  }
],
