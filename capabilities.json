{
  "dataRoles": [
    {
      "name": "category",
      "kind": "Grouping",
      "displayName": "Category"
    },
    {
      "name": "imageUri",
      "kind": "Measure",
      "displayName": "Image"
    },
    {
      "name": "value",
      "kind": "Measure",
      "displayName": "Value"
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltips"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "imageUri": {
            "max": 1
          },
          "value": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "imageUri"
              }
            },
            {
              "bind": {
                "to": "value"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
  "sorting": {
    "default": {}
  },
  "objects": {
    "playback": {      
      "properties": {
        "selectionSequence": {
          "type": {
            "bool": true
          }
        },
        "defaultFrameDuration": {          
          "type": {
            "numeric": true
          }
        }
      }
    },
    "transition": {      
      "properties": {
        "show": {          
          "type": {
            "bool": true
          }
        },
        "transitionType": {          
          "type": {
            "enumeration": []
          }
        },
        "transitionDuration": {          
          "type": {
            "numeric": true
          }
        }
      }
    },
    "caption": {      
      "properties": {
        "show": {          
          "type": {
            "bool": true
          }
        },
        "position": {          
          "type": {
            "enumeration": []
          }
        },
        "type": {          
          "type": {
            "enumeration": []
          }
        },
        "indexType": {          
          "type": {
            "enumeration": []
          }
        },
        "indexPosition": {          
          "type": {
            "enumeration": []
          }
        },
        "color": {          
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "fontFamily": {          
          "type": {
            "formatting": {
              "fontFamily": true
            }
          }
        },
        "fontSize": {          
          "type": {
            "formatting": {
              "fontSize": true
            }
          }
        },
        "bold": {          
          "type": {
            "bool": true
          }
        },
        "italic": {          
          "type": {
            "bool": true
          }
        },
        "underline": {          
          "type": {
            "bool": true
          }
        }
      }
    },
    "navigation": {      
      "properties": {
        "show": {          
          "type": {
            "bool": true
          }
        },
        "position": {          
          "type": {
            "enumeration": []
          }
        },
        "activeDotColor": {          
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "showDotNumbers": {          
          "type": {
            "bool": true
          }
        },
        "dotNumbersColor": {          
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "general": {      
      "properties": {
        "imageAlignment": {          
          "type": {
            "enumeration": []
          }
        },
        "backgroundColor": {          
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    }
  },
  "supportsHighlight": true,
  "supportsKeyboardFocus": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "supportEnhancedTooltips": true,
    "roles": [
      "tooltips"
    ]
  },
  "privileges": [
    {
      "name": "WebAccess",
      "essential": true,
      "parameters": [
        "*"
      ]
    }
  ]
}