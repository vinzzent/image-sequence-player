{
  "dataRoles": [
    {
      "name": "category",
      "kind": "Grouping",
      "displayName": "Category"
    },
    {
      "name": "imageUri",
      "kind": "Measure",
      "displayName": "Image"
    },
    {
      "name": "value",
      "kind": "Measure",
      "displayName": "Value"
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltips"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "imageUri": {
            "max": 1
          },
          "value": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 3500
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "imageUri"
              }
            },
            {
              "bind": {
                "to": "value"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
  "sorting": {
    "default": {}
  },
  "objects": {
    "playback": {
      "displayName": "Playback Settings",
      "properties": {
        "selectionSequence": {
          "displayName": "Selection Sequence",
          "description": "Enable to apply a filter for each frame during playback.",
          "type": {
            "bool": true
          }
        },
        "defaultFrameDuration": {
          "displayName": "Default Frame Duration (ms)",
          "description": "The time each frame is displayed during playback.",
          "type": {
            "numeric": true
          }
        }
      }
    },
    "transition": {
      "displayName": "Transition Settings",
      "properties": {
        "show": {
          "displayName": "Enable Transitions",
          "type": {
            "bool": true
          }
        },
        "transitionType": {
          "displayName": "Transition Type",
          "type": {
            "enumeration": []
          }
        },
        "transitionDuration": {
          "displayName": "Transition Duration (ms)",
          "type": {
            "numeric": true
          }
        }
      }
    },
    "caption": {
      "displayName": "Caption Settings",
      "properties": {
        "show": {
          "displayName": "Show Caption",
          "type": {
            "bool": true
          }
        },
        "position": {
          "displayName": "Position",
          "type": {
            "enumeration": []
          }
        },
        "type": {
          "displayName": "Type",
          "type": {
            "enumeration": []
          }
        },
        "color": {
          "displayName": "Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "fontFamily": {
          "displayName": "Font",
          "type": {
            "formatting": {
              "fontFamily": true
            }
          }
        },
        "fontSize": {
          "displayName": "Font Size",
          "type": {
            "formatting": {
              "fontSize": true
            }
          }
        },
        "bold": {
          "displayName": "Bold",
          "type": {
            "bool": true
          }
        },
        "italic": {
          "displayName": "Italic",
          "type": {
            "bool": true
          }
        },
        "underline": {
          "displayName": "Underline",
          "type": {
            "bool": true
          }
        }
      }
    },
    "navigation": {
      "displayName": "Navigation Settings",
      "properties": {
        "show": {
          "displayName": "Show Navigation Dots",
          "type": {
            "bool": true
          }
        },
        "position": {
          "displayName": "Position",
          "type": {
            "enumeration": []
          }
        },
        "activeDotColor": {
          "displayName": "Active Dot Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "showDotNumbers": {
          "displayName": "Show Dot Numbers",
          "type": {
            "bool": true
          }
        },
        "dotNumbersColor": {
          "displayName": "Dot Numbers Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "general": {
      "displayName": "General Settings",
      "properties": {
        "imageAlignment": {
          "displayName": "Image Alignment",
          "type": {
            "enumeration": []
          }
        },
        "backgroundColor": {
          "displayName": "Background Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    }
  },
  "supportsHighlight": true,
  "supportsKeyboardFocus": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "supportEnhancedTooltips": true,
    "roles": [
      "tooltips"
    ]
  },
  "privileges": [
    {
      "name": "WebAccess",
      "essential": true,
      "parameters": [
        "*"
      ]
    }
  ]
}